# Producción
NODE_ENV=production
APP_NAME=colpruebas
ENVIRONMENT=production
FRONTEND_PORT=4321
API_PORT=3005
PUBLIC_API_URL=http://localhost:3005
# Firma PUBLIC_* build-time SSR (inyectadas vía compose dev/prod + Dockerfile.prod ARG/ENV,
# tipadas en frontend/src/env.d.ts). Fallbacks documentados: PUBLIC_ENVIRONMENT ausente → test;
# PUBLIC_GIT_BRANCH ausente → develop.
PUBLIC_ENVIRONMENT=production
PUBLIC_GIT_BRANCH=develop
