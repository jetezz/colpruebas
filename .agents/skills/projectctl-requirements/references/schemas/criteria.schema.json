{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectctl-criteria/v1",
  "title": "Projectctl criteria manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "criteria"],
  "properties": {
    "schema": { "const": "projectctl-criteria/v1" },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "requirement", "owner", "source", "revision", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^PCT-[0-9]+$" },
        "type": {
          "enum": ["behavior", "contract", "tooling", "visual", "a11y", "operational", "docs"]
        },
        "title": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "revision": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "historical"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "mapping"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PCT-CAND-20260908-PCTMAP-[ARM][0-9]{2}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "task-scoped" },
        "mapping": { "const": "unassigned" },
        "related_ac": { "type": "string", "pattern": "^AC-[0-9]{3}$" }
      }
    }
  }
}
