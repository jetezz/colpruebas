---
import Header from '../components/Header.astro';
import InfoCard from '../components/InfoCard.astro';
import Footer from '../components/Footer.astro';
import type { RuntimeEnvironment } from '../../../shared/contracts/runtime';

// @criterion HOME-01
// @trace ac=HOME-01 req=REQ-CODETRACE-002 view=home tab=none block=identity-source
// @contract auth=none ownership=none side-effects=none
const appName = 'colpruebas';
const environment = (import.meta.env.PUBLIC_ENVIRONMENT || 'test') as RuntimeEnvironment;
const timestamp = new Date().toISOString();

const frontendStatus =
  environment === 'production'
    ? 'Estamos en el frontend de PRODUCCIÓN'
    : environment === 'development'
      ? 'Estamos en el frontend de DESARROLLO'
      : 'Estamos en el frontend de TEST';

const fallbackApiStatus =
  environment === 'production'
    ? 'API de producción funcionando'
    : environment === 'development'
      ? 'API de desarrollo funcionando'
      : 'API de test funcionando';

// HSS-03: salud real vía fetch SSR con timeout corto + degradado graceful al
// texto estático (sin console.error → protege HOME-05).
// @criterion HOME-05
// @trace ac=HOME-05 req=REQ-CODETRACE-002 view=home tab=none block=ssr-health-degraded
// @contract auth=none ownership=none side-effects=none
const apiBaseUrl = (import.meta.env.PUBLIC_API_URL || '').replace(/\/+$/, '');
let apiStatus = fallbackApiStatus;
try {
  if (apiBaseUrl) {
    // Respuesta ok → texto operativo del entorno; cualquier otro caso
    // conserva el fallback estático asignado antes del try.
    const healthRes = await fetch(`${apiBaseUrl}/health`, {
      signal: AbortSignal.timeout(2000),
    });
    if (healthRes.ok) {
      apiStatus = fallbackApiStatus;
    }
  }
} catch {
  apiStatus = fallbackApiStatus;
}

// HRM-01: rama git real build-time SSR con fallback documentado a develop.
// @criterion HRM-01
// @trace ac=HRM-01 req=REQ-CODETRACE-002 view=home tab=none block=branch-resolution
// @contract auth=none ownership=none side-effects=none
const gitBranch = import.meta.env.PUBLIC_GIT_BRANCH || 'develop';
---

<!-- @trace not-evaluated=true reason=entrypoint block=home-entrypoint -->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{appName}</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }
      .container {
        background: white;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        max-width: 600px;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Header title={appName} />
      <InfoCard 
        appName={appName}
        environment={environment}
        frontendStatus={frontendStatus}
        apiStatus={apiStatus}
        gitBranch={gitBranch}
      />
      <Footer timestamp={timestamp} />
    </div>
  </body>
</html>
<!-- HMR TEST -->
