---
interface Props {
  appName: string;
  environment: string;
  frontendStatus: string;
  apiStatus: string;
  gitBranch: string;
}

const { appName, environment, frontendStatus, apiStatus, gitBranch } = Astro.props;
---

<!-- @criterion HSS-01 -->
<!-- @trace ac=HSS-01 req=REQ-CODETRACE-002 view=home tab=none block=status-summary -->
<!-- @contract auth=none ownership=none side-effects=none -->
<div class="info-card">
  <div class="info-row">
    <span class="label">Aplicación:</span>
    <span class="value">{appName}</span>
  </div>
 
  <!-- @criterion HSS-02 -->
  <!-- @trace ac=HSS-02 req=REQ-CODETRACE-002 view=home tab=none block=frontend-row -->
  <!-- @contract auth=none ownership=none side-effects=none -->
  <div class="info-row">
    <span class="label">Frontend:</span>
    <span class={`value ${environment}`}>{frontendStatus}</span>
  </div>
  <div class="info-row">
    <span class="label">API:</span>
    <span class={`value ${environment}`}>{apiStatus}</span>
  </div>
  <!-- @criterion HSS-04 -->
  <!-- @trace ac=HSS-04 req=REQ-CODETRACE-002 view=home tab=none block=branch-row -->
  <!-- @contract auth=none ownership=none side-effects=none -->
  <div class="info-row">
    <span class="label">Rama Git:</span>
    <span class={`value ${environment}`}>{gitBranch}</span>
  </div>
</div>

<style>
  .info-card {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e9ecef;
  }
  .info-row:last-child {
    border-bottom: none;
  }
  .label {
    font-weight: 600;
    color: #495057;
  }
  .value {
    color: #667eea;
    font-weight: 500;
  }
  .value.production {
    color: #28a745;
  }
  .value.development {
    color: #17a2b8;
  }
  .value.test {
    color: #ffc107;
  }
</style>
