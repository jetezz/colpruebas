{
  "name": "colpruebas",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "projectctl": "bun scripts/projectctl-root.ts",
    "sdd:doctor": "bun scripts/sdd-doctor.ts",
    "docs:lint": "bun scripts/projectctl-docs.ts lint",
    "docs:check": "bun scripts/projectctl-docs.ts check",
    "docs:status": "bun scripts/projectctl-docs.ts status",
    "docs:generate": "bun scripts/projectctl-docs.ts generate",
    "taskflow:check": "bun scripts/taskflow.ts --check",
    "taskflow:generate": "bun scripts/taskflow.ts --generate",
    "test": "bun run test:all",
    "test:unit": "bun run scripts/test-runner.ts run --method=unit --target=home",
    "test:unit:home": "bun run scripts/test-runner.ts run --method=unit --target=home",
    "test:pwauto": "bun run scripts/test-runner.ts run --method=pwauto --target=home",
    "test:pwauto:home": "bun run scripts/test-runner.ts run --method=pwauto --target=home",
    "test:all": "bun run scripts/test-runner.ts run --method=all --target=home",
    "test:all:home": "bun run scripts/test-runner.ts run --method=all --target=home",
    "test:check": "bun run scripts/test-runner.ts check"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}
